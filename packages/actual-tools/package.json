{
  "name": "@dsh-plus/actual-tools",
  "version": "0.1.1",
  "description": "dsh-plus preset tool plugin: Actual Budget 能力包装——把主插件发现的 Actual 能力清单 1:1 注册为 agent 作用域 DSH 工具（写操作确认 + CLI 兜底执行）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts -d lib --format esm --dts --no-fixed-extension"
  },
  "dependencies": {
    "@dsh-plus/actual": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/actual-tools"
  }
}
