{
  "name": "@dsh-plus/web-files",
  "version": "0.3.6",
  "description": "dsh-plus ui plugin: Web 内嵌类 SFTP 文件浏览与编辑（远程/移动端无本地编辑器时预览并编辑服务器文件）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "external": [
        "@deepseek-ai/dsh-util-workspace-path"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.2-alpha.2"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.2",
    "@lezer/highlight": "^1.2.3",
    "@types/react": "^18.3.31",
    "codemirror": "^6.0.2",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/web-files"
  }
}
