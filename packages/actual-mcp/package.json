{
  "name": "@dsh-plus/actual-mcp",
  "version": "0.1.4",
  "description": "dsh-plus portable MCP server: 把本机 @actual-app/cli 按 help 文本运行时自动封装为 MCP 服务（命令族×动作×参数零硬编码），供任意 MCP 宿主使用",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-plus-actual-mcp": "./lib/bin/mcp.js",
    "actual-mcp": "./lib/bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin/mcp.ts -d lib --format esm --dts --no-fixed-extension"
  },
  "dependencies": {
    "@dsh-plus/actual-reports": "workspace:*",
    "@modelcontextprotocol/server": "2.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/actual-mcp"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0"
  }
}
