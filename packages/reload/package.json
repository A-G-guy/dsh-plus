{
  "name": "@dsh-plus/reload",
  "version": "0.2.4",
  "description": "dsh-plus service+ui plugin: 设置页「重新加载」按钮与 /reload 命令——默认进程内重载 profile 组合层（零中断、不刷新页面）并点名只能重启生效的插件，重启服务保留为次级动作",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-hmr": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/react": "~18.3.31",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/reload"
  }
}
