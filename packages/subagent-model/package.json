{
  "name": "@dsh-plus/subagent-model",
  "version": "0.2.1",
  "description": "dsh-plus service plugin: 为 subagent/subagent_fork 等子代理按 provider 配置模型与思考程度（或继承主代理）",
  "type": "module",
  "main": "lib/index.js",
