    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
