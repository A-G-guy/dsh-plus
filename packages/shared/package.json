{
  "name": "@dsh-plus/shared",
  "version": "0.1.4",
  "description": "dsh-plus workspace shared pure helpers (not a dsh plugin)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./src/client/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts -d lib --format esm --dts --no-fixed-extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/shared"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
