{
  "name": "@dsh-plus/bundle-main",
  "version": "0.1.2",
  "description": "dsh-plus aggregate bundle: ordered cordis patch layer wiring all dsh-plus plugins",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown src/index.ts -d lib --format esm --dts"
  },
  "dependencies": {
    "@dsh-plus/ui-mobile-fit": "workspace:*",
    "@dsh-plus/notify-email": "workspace:*",
    "@dsh-plus/subagent-model": "workspace:*",
    "@dsh-plus/llm-pi": "workspace:*",
    "@dsh-plus/skill-manual": "workspace:*",
    "@dsh-plus/lifeboat": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-G-guy/dsh-plus.git",
    "directory": "packages/bundle-main"
  }
}
